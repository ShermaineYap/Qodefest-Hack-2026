# Qwen via Alibaba Cloud Model Studio (international / Singapore endpoint)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Extra CORS origins, comma separated (chrome-extension:// and localhost are already allowed)
ALLOWED_ORIGINS=
# Kill switch: set to 1 to make the endpoint return 503
ASSISTANT_DISABLED=
